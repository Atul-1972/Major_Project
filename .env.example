# Existing planned settings retained from project preparation.
# These legacy names are documentation, not new runtime configuration loading.
SKINAI_ENV=development
SKINAI_HOST=127.0.0.1
SKINAI_PORT=8000
SKINAI_MODEL_DIR=ai_model/exports/selected
SKINAI_MAX_UPLOAD_BYTES=10485760
SKINAI_MAX_IMAGE_PIXELS=20000000
SKINAI_RETAIN_UPLOADS=false

# Chatbot documentation template: the app reads process environment variables.
# Copy values into your shell environment, or your own private environment loader.
# Never commit real credentials or paste them into chat. No key/model is provided here.
SKINAI_CHAT_ENABLED=1
SKINAI_CHAT_PROVIDER=openai
SKINAI_CHAT_BASE_URL=https://api.openai.com/v1
SKINAI_CHAT_MODEL=
SKINAI_CHAT_API_KEY=
# Set to 1 only when serving the application through HTTPS.
SKINAI_CHAT_SECURE_COOKIE=0
